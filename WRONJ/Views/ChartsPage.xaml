<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WRONJ.Views.ChartsPage"
             xmlns:scott="clr-namespace:ScottPlot.Maui;assembly=ScottPlot.Maui"
             Title="ChartsPage">
    <Grid>
    <Grid ColumnDefinitions="*,*,*" IsVisible="{OnPlatform iOS=False, Android=False, WinUI=True}">
        <scott:MauiPlot x:Name="workerTimeChart" VerticalOptions="Fill" HorizontalOptions="Fill"/>
        <scott:MauiPlot x:Name="timesChart" VerticalOptions="Fill" HorizontalOptions="Fill" Grid.Column="1"/>
        <scott:MauiPlot x:Name="workersChart" VerticalOptions="Fill" HorizontalOptions="Fill" Grid.Column="2"/>
            <!--scott:MauiPlot Plot="{Binding Plot1}" Grid.Column="1" VerticalOptions="Fill" HorizontalOptions="Fill"/>
    <scott:PlotView Plot="{Binding Plots[2]}" Grid.Column="2" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"/-->
    </Grid>
    <!--CarouselView ItemsSource="{Binding Plots}" IsVisible="{OnPlatform iOS=True, Android=True, WinUI=True}">
        <CarouselView.ItemTemplate>
            <DataTemplate>
                <scott:MauiPlot BindingContext="{Binding}" VerticalOptions="Fill" HorizontalOptions="Fill"/>
            </DataTemplate>
        </CarouselView.ItemTemplate>
    </CarouselView-->
    </Grid>
</ContentPage>