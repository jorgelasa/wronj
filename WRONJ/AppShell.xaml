<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WRONJ.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WRONJ.Views"
    Title="Grid simulator and the WRONJ problem">

    <!-- Model: abre ItemsPage -->
    <FlyoutItem Title="Model" Icon="dotnet_bot.png">
        <ShellContent
            Title="Model"
            ContentTemplate="{DataTemplate local:ItemsPage}"
            Route="ItemsPage"/>
    </FlyoutItem>

    <!-- Help: abre URL externa -->
    <MenuItem
        Text="Help"
        CommandParameter="https://github.com/jorgelasa/wronj/blob/master/README.md#the-wronj-problem"
        Clicked="OnHelpClicked" />

    <!-- About: navega a AboutPage -->
    <FlyoutItem Title="About" Icon="dotnet_bot.png">
        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate local:AboutPage}"
            Route="AboutPage" />
    </FlyoutItem>

</Shell>
